{
  "rules": {
    ".read": false,
    ".write": false,
    "access": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "casos": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('active').val() === true && (root.child('access').child(auth.uid).child('role').val() === 'administrador' || root.child('access').child(auth.uid).child('role').val() === 'coordenador' || root.child('access').child(auth.uid).child('role').val() === 'tecnico')",
      "$caseId": {
        ".write": "auth != null && root.child('access').child(auth.uid).child('active').val() === true && (root.child('access').child(auth.uid).child('role').val() === 'administrador' || root.child('access').child(auth.uid).child('role').val() === 'coordenador' || root.child('access').child(auth.uid).child('role').val() === 'tecnico') && newData.exists() && (data.exists() || root.child('access').child(auth.uid).child('role').val() === 'administrador' || (!$caseId.matches(/^import_[0-9a-f]{64}$/) && newData.child('origemCadastro').val() !== 'planilha'))",
        ".validate": "newData.hasChildren(['numeroProntuario', 'dataEntrada']) && (!data.child('origemCadastro').exists() || newData.child('origemCadastro').val() === data.child('origemCadastro').val())",
        "numeroProntuario": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
        },
        "origemCadastro": {
          ".validate": "newData.isString() && (newData.val() === 'manual' || newData.val() === 'planilha') && (!data.exists() || newData.val() === data.val())"
        },
        "dataEntrada": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "situacaoAtual": {
          ".validate": "newData.isString() && (newData.val() === 'ativo' || newData.val() === 'suspenso' || newData.val() === 'encerrado_com_protecao' || newData.val() === 'encerrado_sem_protecao' || newData.val() === 'nao_competencia')"
        },
        "$other": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        }
      }
    }
  }
}
